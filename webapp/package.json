{
  "name": "tcr",
  "version": "1.5.0",
  "description": "TCR Web Application",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-prod": "ng build --output-path ../src/http/static/webapp --configuration production --extract-licenses false",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run --config vitest.config.mjs",
    "coverage": "vitest run --coverage --config vitest.config.mjs",
    "test-watch": "vitest --config vitest.config.mjs",
    "lint": "ng lint",
    "clean": "rm -rf node_modules ../src/http/static/webapp",
    "reinstall": "npm run clean && npm install",
    "rebuild": "npm run reinstall && npm run build",
    "rebuild-prod": "npm run reinstall && npm run build-prod"
  },
  "private": true,
  "engines": {
    "npm": ">=10.8.1",
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ansicolor": "^2.0.3",
    "bootstrap": "^5.3.8",
    "ng-terminal": "^6.7.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular-eslint/builder": "^22.3.0",
    "@angular-eslint/eslint-plugin": "^22.3.0",
    "@angular-eslint/eslint-plugin-template": "^22.3.0",
    "@angular-eslint/schematics": "^22.3.0",
    "@angular-eslint/template-parser": "^22.3.0",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@angular/localize": "^22.1.5",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "angular-eslint": "^22.3.0",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.0",
    "ng-mocks": "^14.17.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "esbuild@0.28.2": true
  }
}
